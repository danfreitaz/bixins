    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "latest",
    "typescript": "^5.9.0",
    "vitest": "latest"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
